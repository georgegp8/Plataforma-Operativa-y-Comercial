APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=minio
QUEUE_CONNECTION=database

# MinIO Configuration (S3 Compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=facturacion
MINIO_REGION=us-east-1
MINIO_USE_PATH_STYLE_ENDPOINT=true

# OCR Configuration
OCR_USE_DOCKER=true

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# CONFIGURACIÓN DE EMAIL (Gmail)
# ============================================
# Para usar Gmail:
# 1. Habilita "Verificación en 2 pasos" en tu cuenta de Google
# 2. Ve a: https://myaccount.google.com/apppasswords
# 3. Genera una "Contraseña de aplicación" para "Correo"
# 4. Usa esa contraseña en MAIL_PASSWORD (no tu contraseña normal)
#
# Ejemplo con Gmail:
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=george.guerra@tecsup.edu.pe
MAIL_PASSWORD=tu_app_password_aqui
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=george.guerra@tecsup.edu.pe
MAIL_FROM_NAME="${APP_NAME}"
#
# Para desarrollo (sin enviar emails reales):
# MAIL_MAILER=log

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================
# CONFIGURACIÓN DE NUBEFACT API
# ============================================
# Obtén tus credenciales desde:
# 1. www.nubefact.com → Login → API (Integración)
# 2. O desde tuempresa.pse.pe → API (Integración) [si eres Reseller]
#
# IMPORTANTE: NUNCA subas estas credenciales a Git
# Este archivo (.env) está en .gitignore por seguridad
#
NUBEFACT_BASE_URL=https://api.pse.pe/api/v1/TU_RUC_KEY_AQUI
NUBEFACT_TOKEN=TU_TOKEN_JWT_AQUI
NUBEFACT_TIMEOUT=30
NUBEFACT_AUTO_SUNAT=true
NUBEFACT_AUTO_EMAIL=false
NUBEFACT_PDF_FORMAT=A4
NUBEFACT_INCLUDE_BASE64=false
NUBEFACT_MODE=demo
NUBEFACT_GRE_MAX_RETRIES=10
NUBEFACT_GRE_RETRY_DELAY=5
