APP_NAME="Plataforma Facturación"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# BASE DE DATOS — PostgreSQL
# ============================================
# Servidor de producción: instalación nativa en Debian 12
# Desarrollo local: contenedor Docker (docker compose up -d)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=plataforma_facturacion
DB_USERNAME=postgres
DB_PASSWORD=postgres123

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

# ============================================
# STORAGE — MinIO (S3 Compatible)
# ============================================
# Desarrollo local: contenedor Docker en puerto 9000
# Console MinIO: http://localhost:9001 (minio / minio123)
# Ver docs/DESPLIEGUE.md para configuración de producción
FILESYSTEM_DISK=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_KEY=minio
MINIO_SECRET=minio123
MINIO_BUCKET=facturacion
MINIO_REGION=us-east-1
MINIO_USE_PATH_STYLE_ENDPOINT=true

# ============================================
# OCR — Reconocimiento de documentos
# ============================================
# Modo Docker: usa Tesseract (español) en contenedor local
# Modo Gemini: usa Google AI Studio API (más preciso)
OCR_USE_DOCKER=true

# Google Gemini API Key (para OCR inteligente)
# Obtener en: https://aistudio.google.com/apikey
# Ver docs/DESPLIEGUE.md sección B.3 para instrucciones detalladas
GEMINI_API_KEY=

CACHE_STORE=database
CACHE_PREFIX=

# ============================================
# EMAIL — Gmail SMTP
# ============================================
# Para envío automático de comprobantes al cliente al emitir.
#
# PASOS PARA CONFIGURAR GMAIL:
# 1. Activar verificación en 2 pasos:
#    https://myaccount.google.com/security
# 2. Generar App Password (contraseña de aplicación):
#    https://myaccount.google.com/apppasswords
#    → Nombre: "Plataforma Facturacion" → Crear
#    → Copiar las 16 letras generadas (formato: xxxx xxxx xxxx xxxx)
# 3. Colocar esas 16 letras en MAIL_PASSWORD (no tu contraseña normal)
#
# Para desarrollo (sin enviar emails reales):
#   MAIL_MAILER=log   (emails se guardan en storage/logs/laravel.log)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=correo-empresa@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=correo-empresa@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# NUBEFACT API — Facturación Electrónica SUNAT
# ============================================
# PSE (Proveedor de Servicios Electrónicos) integrado con SUNAT Perú.
#
# OBTENER CREDENCIALES:
# 1. Ingresar a https://nubefact.com con la cuenta de la empresa
# 2. Ir a Configuración → API / Integración
# 3. Copiar la URL de API (contiene el RUC key)
# 4. Copiar el Token JWT (empieza con eyJ...)
#
# MODOS:
#   demo       → https://api.pse.pe/api/v1/{ruc_key}    (pruebas, no envía a SUNAT)
#   production → https://api.nubefact.com/api/v1/{ruc_key} (producción real)
#
# IMPORTANTE: NUNCA subir estas credenciales al repositorio.
# Este archivo .env está en .gitignore por seguridad.
NUBEFACT_BASE_URL=https://api.pse.pe/api/v1/TU_RUC_KEY_AQUI
NUBEFACT_TOKEN=TU_TOKEN_JWT_AQUI
NUBEFACT_TIMEOUT=30
NUBEFACT_AUTO_SUNAT=true
NUBEFACT_AUTO_EMAIL=false
NUBEFACT_PDF_FORMAT=A4
NUBEFACT_INCLUDE_BASE64=false
NUBEFACT_MODE=demo
NUBEFACT_GRE_MAX_RETRIES=10
NUBEFACT_GRE_RETRY_DELAY=5

# ============================================
# AWS S3 (Alternativa a MinIO en producción)
# ============================================
# Solo configurar si se migra de MinIO a S3 real.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
